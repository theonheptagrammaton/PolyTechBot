// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  telegramId       String   @unique
  username         String?
  firstName        String?
  lastName         String?

  // EVM wallet for deposits (Polygon, Ethereum, BNB)
  walletAddress    String   @unique
  encryptedPrivateKey String

  // Predexon managed user ID (UUID from Predexon Trading API)
  predexonUserId   String?

  // Polymarket Proxy/Safe wallet (for trading)
  polymarketProxyAddress String?

  // Polymarket Deposit Addresses (from Bridge API)
  depositAddressEvm String? // Ethereum, Arbitrum, Base, Optimism, etc.
  depositAddressSvm String? // Solana
  depositAddressBtc String? // Bitcoin
  depositAddressTvm String? // Tron

  // Solana wallet (encrypted) - DEPRECATED, not used
  solanaAddress    String?
  encryptedSolanaPrivateKey String?

  // API credentials (encrypted)
  encryptedApiKey    String
  encryptedApiSecret String
  encryptedPassphrase String

  // 2FA settings (encrypted)
  twoFactorSecret     String?
  twoFactorEnabled    Boolean  @default(false)
  backupCodes         String?  // JSON array of backup codes

  // Trading settings
  defaultTradeAmount  Int      @default(25)  // Default trade amount in USD
  slippageTolerance   Float    @default(1.0) // Max slippage % for market orders (0.1–25)
  language            String   @default("en")  // User language: en, zh, ru
  tradingEnabled      Boolean  @default(false) // Whether CTF trading is enabled (one-time approval)

  // Referral system
  referralCode        String?  @unique        // User's referral code (username or random)
  customReferralPct   Float?                  // Admin-set custom Tier 1 referral % (null = default 25%)
  referredById        String?                 // ID of the user who referred this user
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  referralClaimable   Float    @default(0)    // Accumulated claimable earnings (USD)
  referralEarnedTotal Float    @default(0)    // Total lifetime referral earnings (USD)

  // Cashback system (10% of platform fee returned to the trader)
  cashbackClaimable   Float    @default(0)    // Accumulated claimable cashback (USD)
  cashbackEarnedTotal Float    @default(0)    // Total lifetime cashback earned (USD)

  // Copy trading
  copySubscriptions CopySubscription[]
  copiedTrades      CopiedTrade[]

  // Bond trading (auto strategies)
  bondStrategies   BondStrategy[]
  bondTrades       BondTrade[]

  // Up-Down auto strategies
  updownStrategies UpDownStrategy[]
  updownTrades     UpDownTrade[]

  // Backtest results
  backtestResults  BacktestResult[]

  isAdmin          Boolean  @default(false)
  isActive         Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([telegramId])
  @@index([walletAddress])
  @@index([referralCode])
  @@map("users")
}

model CopySubscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traderAddress  String   // tracked wallet (normalized lowercase)
  label          String?  // optional user-defined label

  // Sizing: exactly one of these is set
  fixedAmount    Float?   // fixed USD amount
  multiplier     Float?   // proportional multiplier (0.1–5.0)

  // Buy method: 'fixed' | 'exact' | 'percentage' | 'portfolio'
  buyMethod      String   @default("fixed")

  // Stop condition
  autoStopBelowBalance Float @default(1.0)

  // Take Profit / Stop Loss (per-subscription)
  takeProfitPct   Float?   // e.g. 50.0 → sell when +50% from entry
  stopLossPct     Float?   // e.g. 25.0 → sell when −25% from entry
  stopLossFixed   Float?   // sell if price drops to this (cents, e.g. 15 = 15¢)
  takeProfitFixed Float?   // sell if price reaches this (cents, e.g. 85 = 85¢)

  // Extended settings (manage page)
  isPaused             Boolean @default(false)  // temporarily paused (isActive remains true)
  notificationsEnabled Boolean @default(true)   // whether to send Telegram trade notifications
  slippage             Float   @default(10.0)   // max slippage % for copied orders
  priceMin             Float?                   // skip trades priced below this (cents)
  priceMax             Float?                   // skip trades priced above this (cents)
  singleTradeMax       Float?                   // max USD per single copied trade (maxBuyAmount)
  minBuyAmount         Float?                   // min USD per single BUY
  maxSpendPerMarket    Float?                   // max USD spend per single market condition
  maxSpendTotal        Float?                   // lifetime max total spend
  dailySpendMax        Float?                   // max USD to spend per day on this subscription

  // Market filters
  minTriggerPrice Float?   // only copy if price >= X cents
  maxTriggerPrice Float?   // only copy if price <= X cents
  maxDaysOut      Int?     // skip markets expiring > N days
  minLiquidity    Float?   // min liquidity in USD
  minVolume       Float?   // min volume in USD
  categories      String?  // comma-separated category list or null=all

  // Trade behavior
  followBuys     Boolean  @default(true)   // follow leader's BUY trades
  copySells      Boolean  @default(true)   // copy leader's SELL trades
  buyOnSells     Boolean  @default(false)  // BUY when leader SELLs
  counterTrade   Boolean  @default(false)  // take opposite side of leader
  limitMode      Boolean  @default(false)  // use GTC limit orders instead of FAK market
  copySide       String   @default("both") // 'both' | 'yes' | 'no'

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Back-relation: trades placed under this subscription
  copiedTrades   CopiedTrade[]

  @@unique([userId, traderAddress])
  @@index([isActive])
  @@map("copy_subscriptions")
}

model CommissionLog {
  id        String   @id @default(cuid())
  userId    String?
  amount    Float                      // USDC commission charged
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("commission_logs")
}

model CopiedTrade {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Link to the subscription that placed this trade.
  // Nullable for backward-compat with records created before this field was added.
  // SetNull on subscription delete: trade history is preserved but no longer TP/SL checked.
  subscriptionId String?
  subscription   CopySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  traderAddress  String
  marketId       String
  outcome        String   // YES | NO
  side           String   // BUY | SELL
  sourceSize     Float    // trader's USD size
  copiedSize     Float    // applied USD size for user
  price          Float
  assetId        String?  // CLOB token ID — stored at BUY fill time for TP/SL price lookup
  orderID        String?
  status         String   @default("pending")  // pending|filled|failed|skipped
  tpSlStatus     String?  // 'tp_triggered' | 'sl_triggered' — prevents double-exit
  errorMsg       String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([traderAddress])
  @@index([subscriptionId])
  @@map("copied_trades")
}

model BondStrategy {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String?

  // Trade sizing
  fixedAmount         Float    @default(25.0)
  dailyBudget         Float    @default(100.0)
  maxDailyLoss        Float?

  // Market filters
  minProbability      Float    @default(95.0)
  maxProbability      Float    @default(99.0)
  maxHoursOut         Int      @default(48)
  maxConcurrent       Int      @default(5)
  includeSports       Boolean  @default(false)
  includeCryptoUpDown Boolean  @default(false)
  slippage            Float    @default(5.0)
  minLiquidity        Float?
  minVolume           Float?
  categories          String?
  maxSpendPerMarket   Float?
  maxSpendTotal       Float?

  // Scan settings
  scanInterval        Int      @default(5)
  outcomeSide         String   @default("auto")

  // Status
  isActive            Boolean  @default(true)
  isPaused            Boolean  @default(true)
  notificationsEnabled Boolean @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trades              BondTrade[]

  @@index([userId])
  @@index([isActive, isPaused])
  @@map("bond_strategies")
}

model BondTrade {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId    String?
  strategy      BondStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  conditionId   String
  tokenId       String
  question      String
  outcome       String
  probability   Float
  amount        Float
  price         Float
  orderId       String?
  status        String        @default("pending")
  errorMsg      String?

  createdAt     DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([strategyId])
  @@map("bond_trades")
}

model UpDownStrategy {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String?

  // Target
  coin                String   @default("BTC")
  timeframe           String   @default("15-Minute")

  // Triggers
  timeRangeStart      String   @default("00:00")
  timeRangeEnd        String   @default("14:55")
  upPriceMin          Float    @default(0.01)
  upPriceMax          Float    @default(0.99)
  priceChangeMin      Float    @default(-9999)
  priceChangeMax      Float    @default(9999)

  // Trade settings
  direction           String   @default("up")
  orderType           String   @default("market")
  limitPrice          Float?
  limitTtlSeconds     Int      @default(60)
  amount              Float    @default(25.0)
  maxRounds           Int      @default(10)
  roundsExecuted      Int      @default(0)

  // TP/SL
  takeProfitPct       Float?
  takeProfitPrice     Float?
  stopLossPct         Float?
  stopLossPrice       Float?

  // Status
  isActive            Boolean  @default(true)
  isPaused            Boolean  @default(true)
  notificationsEnabled Boolean @default(true)
  slippage            Float    @default(5.0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trades              UpDownTrade[]

  @@index([userId])
  @@index([isActive, isPaused])
  @@map("updown_strategies")
}

model UpDownTrade {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId      String?
  strategy        UpDownStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  conditionId     String
  tokenId         String
  question        String
  coin            String
  direction       String
  roundStartPrice Float?
  triggerPrice    Float
  amount          Float
  fillPrice       Float?
  orderId         String?
  status          String          @default("pending")
  tpSlOrderId     String?
  tpSlStatus      String?
  errorMsg        String?

  createdAt       DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([strategyId])
  @@map("updown_trades")
}

model BacktestResult {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  strategyType   String   // 'bond' | 'copy' | 'updown'
  strategyId     String   // ID of the strategy that was tested
  strategyLabel  String   // snapshot of strategy name at test time

  lookbackDays   Int
  periodStart    DateTime
  periodEnd      DateTime

  totalTrades    Int
  wins           Int
  losses         Int
  winRate        Float    // 0–100
  totalPnl       Float    // USD
  roi            Float    // percentage
  avgProfit      Float    // USD per trade
  maxDrawdown    Float    // USD

  tradesJson     String?  // JSON array of individual simulated trades

  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([strategyId])
  @@map("backtest_results")
}
