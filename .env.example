# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username_without_at_sign
ADMIN_USER_IDS=123456789,987654321

# Predexon Trading API (managed wallets & trading — no Builder quota)
PREDEXON_API_KEY=your_predexon_api_key_here

# Polymarket Configuration (used for market data only)
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137

# Database Configuration
# POSTGRES_PASSWORD is used by docker-compose.yml; keep it in sync with DATABASE_URL
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://polytech:change_me@localhost:5432/polytech_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info

# Encryption (for storing sensitive data)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Admin Wallet — receives 1% commission on every trade
ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddressHere

# Polymarket Builder (Relayer) Credentials (needed for trading)
POLY_BUILDER_API_KEY=your_builder_api_key
POLY_BUILDER_SECRET=your_builder_secret
POLY_BUILDER_PASSPHRASE=your_builder_passphrase

# Platform executor wallet (needs MATIC for gas on Polygon) — submits fee transfer txs
# The executor calls Gnosis Safe execTransaction so user proxy sends USDC to admin wallet
# Fund with ~5 MATIC once — covers 1000+ fee collections at ~$0.003/tx
PLATFORM_EXECUTOR_KEY=0xYourPlatformExecutorPrivateKeyHere

# Referral Treasury — EOA wallet holding USDC.e for automatic referral payouts
# Fund with USDC.e on Polygon; required for auto-withdrawal feature
REFERRAL_TREASURY_KEY=0xYourReferralTreasuryPrivateKeyHere

# Dashboard access token (required by the dashboard service)
DASHBOARD_TOKEN=generate_a_long_random_token

# Optional
# WEBHOOK_DOMAIN=bot.example.com
# WEBHOOK_PORT=8443
# POLYGON_WSS_RPC_URL=wss://...
# ENABLE_GROUP_MODE=true
# GROUP_RATE_LIMIT=10
# TELEGRAM_GROUP_BOT_TOKEN=
# TELEGRAM_REQUIRED_GROUP_ID=
# TELEGRAM_GROUP_LINK=
