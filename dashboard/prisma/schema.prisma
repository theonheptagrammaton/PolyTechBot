// Dashboard read-only copy of the bot's Prisma schema.
// Dashboard never runs migrations — bot owns the schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  telegramId       String   @unique
  username         String?
  firstName        String?
  lastName         String?

  walletAddress    String   @unique
  encryptedPrivateKey String

  predexonUserId   String?

  polymarketProxyAddress String?

  depositAddressEvm String?
  depositAddressSvm String?
  depositAddressBtc String?
  depositAddressTvm String?

  solanaAddress    String?
  encryptedSolanaPrivateKey String?

  encryptedApiKey    String
  encryptedApiSecret String
  encryptedPassphrase String

  twoFactorSecret     String?
  twoFactorEnabled    Boolean  @default(false)
  backupCodes         String?

  defaultTradeAmount  Int      @default(25)
  slippageTolerance   Float    @default(1.0)
  tradingEnabled      Boolean  @default(false)

  referralCode        String?  @unique
  referredById        String?
  referredBy          User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]   @relation("Referrals")
  referralClaimable   Float    @default(0)
  referralEarnedTotal Float    @default(0)
  customReferralPct   Float?

  cashbackClaimable   Float    @default(0)
  cashbackEarnedTotal Float    @default(0)

  copySubscriptions CopySubscription[]
  copiedTrades      CopiedTrade[]
  bondStrategies    BondStrategy[]
  bondTrades        BondTrade[]
  updownStrategies  UpDownStrategy[]
  updownTrades      UpDownTrade[]

  isAdmin          Boolean  @default(false)
  isActive         Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([telegramId])
  @@index([walletAddress])
  @@index([referralCode])
  @@map("users")
}

model CopySubscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  traderAddress  String
  label          String?

  fixedAmount    Float?
  multiplier     Float?

  buyMethod      String   @default("fixed")

  autoStopBelowBalance Float @default(1.0)

  takeProfitPct   Float?
  stopLossPct     Float?
  stopLossFixed   Float?
  takeProfitFixed Float?

  isPaused             Boolean @default(false)
  notificationsEnabled Boolean @default(true)
  slippage             Float   @default(10.0)
  priceMin             Float?
  priceMax             Float?
  singleTradeMax       Float?
  minBuyAmount         Float?
  maxSpendPerMarket    Float?
  maxSpendTotal        Float?
  dailySpendMax        Float?

  minTriggerPrice Float?
  maxTriggerPrice Float?
  maxDaysOut      Int?
  minLiquidity    Float?
  minVolume       Float?
  categories      String?

  followBuys     Boolean  @default(true)
  copySells      Boolean  @default(true)
  buyOnSells     Boolean  @default(false)
  counterTrade   Boolean  @default(false)
  limitMode      Boolean  @default(false)
  copySide       String   @default("both")

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  copiedTrades   CopiedTrade[]

  @@unique([userId, traderAddress])
  @@index([isActive])
  @@map("copy_subscriptions")
}

model CommissionLog {
  id        String   @id @default(cuid())
  userId    String?
  amount    Float
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("commission_logs")
}

model CopiedTrade {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  subscriptionId String?
  subscription   CopySubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  traderAddress  String
  marketId       String
  outcome        String
  side           String
  sourceSize     Float
  copiedSize     Float
  price          Float
  assetId        String?
  orderID        String?
  status         String   @default("pending")
  tpSlStatus     String?
  errorMsg       String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([traderAddress])
  @@index([subscriptionId])
  @@map("copied_trades")
}

model BondStrategy {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String?

  fixedAmount         Float    @default(25.0)
  dailyBudget         Float    @default(100.0)
  maxDailyLoss        Float?

  minProbability      Float    @default(95.0)
  maxProbability      Float    @default(99.0)
  maxHoursOut         Int      @default(48)
  maxConcurrent       Int      @default(5)
  includeSports       Boolean  @default(false)
  includeCryptoUpDown Boolean  @default(false)
  slippage            Float    @default(5.0)
  minLiquidity        Float?
  minVolume           Float?
  categories          String?
  maxSpendPerMarket   Float?
  maxSpendTotal       Float?

  scanInterval        Int      @default(5)
  outcomeSide         String   @default("auto")

  isActive            Boolean  @default(true)
  isPaused            Boolean  @default(true)
  notificationsEnabled Boolean @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trades              BondTrade[]

  @@index([userId])
  @@index([isActive, isPaused])
  @@map("bond_strategies")
}

model BondTrade {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId    String?
  strategy      BondStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  conditionId   String
  tokenId       String
  question      String
  outcome       String
  probability   Float
  amount        Float
  price         Float
  orderId       String?
  status        String        @default("pending")
  errorMsg      String?

  createdAt     DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([strategyId])
  @@map("bond_trades")
}

model UpDownStrategy {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String?

  coin                String   @default("BTC")
  timeframe           String   @default("15-Minute")

  timeRangeStart      String   @default("00:00")
  timeRangeEnd        String   @default("14:55")
  upPriceMin          Float    @default(0.01)
  upPriceMax          Float    @default(0.99)
  priceChangeMin      Float    @default(-9999)
  priceChangeMax      Float    @default(9999)

  direction           String   @default("up")
  orderType           String   @default("market")
  limitPrice          Float?
  limitTtlSeconds     Int      @default(60)
  amount              Float    @default(25.0)
  maxRounds           Int      @default(10)
  roundsExecuted      Int      @default(0)

  takeProfitPct       Float?
  takeProfitPrice     Float?
  stopLossPct         Float?
  stopLossPrice       Float?

  isActive            Boolean  @default(true)
  isPaused            Boolean  @default(true)
  notificationsEnabled Boolean @default(true)
  slippage            Float    @default(5.0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trades              UpDownTrade[]

  @@index([userId])
  @@index([isActive, isPaused])
  @@map("updown_strategies")
}

model UpDownTrade {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId      String?
  strategy        UpDownStrategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  conditionId     String
  tokenId         String
  question        String
  coin            String
  direction       String
  roundStartPrice Float?
  triggerPrice    Float
  amount          Float
  fillPrice       Float?
  orderId         String?
  status          String          @default("pending")
  tpSlOrderId     String?
  tpSlStatus      String?
  errorMsg        String?

  createdAt       DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([strategyId])
  @@map("updown_trades")
}
