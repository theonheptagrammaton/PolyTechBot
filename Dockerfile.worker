FROM node:20-alpine AS builder

WORKDIR /app

RUN apk add --no-cache python3 make g++ cairo-dev pango-dev fontconfig-dev

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma/

RUN npm ci
RUN npm run db:generate

COPY src ./src
RUN npx tsc 2>&1 || (echo "=== TSC ERRORS ABOVE ===" && exit 1)
RUN cp -r src/bot/img dist/bot/img

# ── Production ──────────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache cairo pango fontconfig

COPY package*.json ./
RUN npm ci --omit=dev

COPY prisma ./prisma/
RUN npx prisma generate

COPY --from=builder /app/dist ./dist
COPY src/bot/img ./dist/bot/img

RUN mkdir -p /usr/share/fonts/custom && \
    cp dist/bot/img/fonts/*.ttf /usr/share/fonts/custom/ 2>/dev/null || true && \
    fc-cache -f

RUN mkdir -p /app/logs

COPY docker-entrypoint-worker.sh ./
RUN chmod +x docker-entrypoint-worker.sh

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health',(r)=>{process.exit(r.statusCode===200?0:1)})"

EXPOSE 3001

ENTRYPOINT ["./docker-entrypoint-worker.sh"]
